# Copy to .env.test for npm run test:db and npm run test:api.
# Use SEPARATE test databases: the tests reload the schema and change data. Both names must contain "test".
DATABASE_URL=postgres://postgres:yourpassword@localhost:5432/miniudemy_test
MONGODB_URI=mongodb://localhost:27017
MONGODB_DB=miniudemy_test
BASE_URL=http://localhost:3000
